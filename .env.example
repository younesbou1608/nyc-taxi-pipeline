# Copier en .env et renseigner
# ID du projet GCP, ex. nyc-taxi-pipeline-509022
GCP_PROJECT_ID=mon-projet-gcp
BQ_RAW_DATASET=nyc_taxi_raw
BQ_ANALYTICS_DATASET=nyc_taxi_analytics
BQ_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=

SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8

# Airflow (Docker). AIRFLOW_UID = resultat de `id -u`
AIRFLOW_UID=1000
AIRFLOW_PORT=18080
AIRFLOW_SPARK_DRIVER_MEMORY=1g
